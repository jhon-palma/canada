# Plantilla de configuracion. Copiala y rellenala con los valores de verdad:
#
#   desarrollo   cp .env.example .env.dev    y luego  DJANGO_ENV=dev
#   produccion   cp .env.example .env.prod   y luego  DJANGO_ENV=prod
#
# Si no pones DJANGO_ENV se lee .env a secas. ENV_FILE=/ruta/al/archivo manda
# sobre todo lo demas. Y una variable que ya exista en el entorno del proceso
# gana al archivo, que es como inyectar un secreto desde el panel del servidor
# sin dejarlo escrito en ningun sitio.
#
# Este archivo es el unico de la familia que se versiona, y por eso aqui no
# hay un solo valor real. Los .env, .env.dev y .env.prod los ignora git.

# ----------------------------------------------------------------- basicos
# En produccion DEBUG tiene que ser false. Con true Django ensena la traza
# entera, consultas incluidas, a quien provoque un error.
DEBUG=true

# Raiz publica del sitio, con esquema y sin barra final. De aqui salen el
# dominio canonico, las URLs absolutas y los enlaces del sitemap.
#   desarrollo   http://localhost:8000
#   produccion   https://www.ljrealties.com
SERVER=http://localhost:8000

# Firma las cookies de sesion y los tokens CSRF. Una por entorno, larga y
# distinta. Para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ------------------------------------------------------------- base de datos
DB_NAME=defaultdb
DB_USER=usuario
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Opcional. Por defecto 'require' en produccion y 'prefer' en desarrollo, que
# es lo que suele hacer falta: la base gestionada va por internet y el Postgres
# local no suele tener certificado. Solo se pone a mano para forzar otra cosa.
# DB_SSLMODE=require

# --------------------------------------------------------------- integraciones
FOLLOWUPBOSS_BASE_URL=https://api.followupboss.com/v1/
FOLLOWUPBOSS_API_KEY=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ------------------------------------------- almacenamiento (DigitalOcean Spaces)
# Solo se usan cuando DEBUG es false: en desarrollo los archivos se sirven
# desde disco y estas cuatro no hacen falta.
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media-canada
AWS_S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com

# ------------------------------------------------ importador de fichas (Centris)
# Interprete con el que se lanza scripts/download_data.py.
PYTHON_BIN=python3

# Opcional, y lo normal es dejarlo sin poner: por defecto es la carpeta data/
# del propio proyecto, que es donde el script deja los archivos y resuelve bien
# en cualquier maquina. Escribirlo a mano es como la configuracion de
# produccion acabo apuntando a una ruta de Windows.
# PATH_BASE=/srv/ljrealties/data

# ------------------------------------------------------------------------- FTP
# Sin uso en el repositorio. Se conservan por si los lee algo de fuera; si no
# es el caso, borra estas tres y las credenciales con ellas.
FTP_IP=
FTP_USER=
FTP_PASSWORD=
